+    "10.残缺内容不要强行翻译，要明确说明这里不确定。",
+    "11.只输出改写后的Markdown正文，不要输出任务说明、批注和代码块。",
+    "12.不要使用一级标题，不要使用分隔线。",
+    batch.continuation ? `开头可以用“## ${batch.section}（续）”作标题。` : "遇到卷首标题时，用现代中文标题表达。",
+    "原文批次如下：",
+    batch.source,
+  ].join("\n");
+}
+
+function sleep(ms) {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+async function callModel(prompt) {
+  const body = {
+    model: "glm-5.3",
+    input: [{ role: "user", content: [{ type: "input_text", text: prompt }] }],
+    reasoning: { effort: "low" },
+    max_output_tokens: 24000,
+  };
+  const controller = new AbortController();
+  const timeout = setTimeout(() => controller.abort(), 10 * 60 * 1000);
+  try {
+    const response = await fetch(endpoint, {
+      method: "POST",
+      headers: { Authorization: `Bearer ${apiKey}`, "Content-Type": "application/json" },
+      body: JSON.stringify(body),
+      signal: controller.signal,
+    });
+    const responseText = await response.text();
+    if (!response.ok) throw new Error(`HTTP ${response.status}: ${responseText.slice(0, 500)}`);
+    const data = JSON.parse(responseText);
+    const texts = [];
+    for (const output of data.output || []) {
+      for (const content of output.content || []) {
+        if (content.type === "output_text" && typeof content.text === "string") texts.push(content.text);
+      }
+    }
+    const result = texts.join("\n").trim();
+    if (!result) throw new Error(`Empty model output: ${responseText.slice(0, 500)}`);
+    return result;
+  } finally {
+    clearTimeout(timeout);
+  }
+}
+
+function batchPath(batch) {
+  return path.join(stateDir, `${String(batch.id).padStart(4, "0")}.md`);
+}
+
+function readBatch(batch) {
+  const file = batchPath(batch);
+  if (!fs.existsSync(file)) return "";
+  return fs.readFileSync(file, "utf8").trim();
+}
+
+function normalizeBatchOutput(output) {
+  const splitSentenceLine = (line) => line
+    .split(/(?<=[。！？；])(?![”』」）】])/)
+    .flatMap((piece) => piece.split(/(?<=[”』」）】])(?=[^\s”』」）】。！？；])/))
+    .filter(Boolean);
+
+  return output
+    .replace(/\r\n?/g, "\n")
+    .split("\n")
+    .filter((line) => !/^---\s*$/.test(line.trim()))
+    .flatMap((line) => {
+      if (line.startsWith("# ")) return `#${line}`;
+      if (line.trim() === "**解题**") return ["### 解题"];
+      if (line.trim() === "钦定四库全书") return "这一页属于《钦定四库全书》。";
+      const trimmed = line.trim();
+      if (trimmed && !trimmed.startsWith("#") && !/[。！？；：）】”]$/.test(trimmed)) return `${line}。`;
+      return line;
+    })
+    .join("\n")
+    .trim();
+}
+
+async function processBatch(batch) {
+  const existing = readBatch(batch);
+  if (existing) {
+    console.log(`[skip] ${batch.id}/${batch.section}/${batch.part}`);
+    return existing;
+  }
+  let lastError;
+  for (let attempt = 1; attempt <= 6; attempt += 1) {
+    try {
+      const started = Date.now();
+      const result = await callModel(makePrompt(batch));
+      if (result.length < Math.max(100, batch.source.length * 0.25)) {
+        throw new Error(`Output too short: source=${batch.source.length}, output=${result.length}`);
+      }
+      fs.writeFileSync(batchPath(batch), result, "utf8");
+      console.log(`[done] ${batch.id}/${batch.section}/${batch.part} source=${batch.source.length} output=${result.length} ms=${Date.now() - started}`);
+      return result;
+    } catch (error) {
+      lastError = error;
+      console.error(`[retry] ${batch.id}/${batch.section}/${batch.part} attempt=${attempt}: ${error.message}`);
+      await sleep(Math.min(60000, 5000 * attempt ** 2));
+    }
+  }
+  throw lastError;
+}
+
+async function runLimited(batches) {
+  const queue = batches.slice();
+  const workers = Array.from({ length: Math.min(concurrency, queue.length) }, async () => {
+    while (queue.length > 0) {
+      const batch = queue.shift();
+      await processBatch(batch);
+    }
+  });
+  await Promise.all(workers);
+}
+
+function validateOutputs(batches) {
+  const problems = [];
+  for (const batch of batches) {
+    const output = normalizeBatchOutput(readBatch(batch));
+    if (!output) {
+      problems.push(`${batch.id}: missing output`);
+      continue;
+    }
+    if (/\|\s*-{3,}/.test(output) || /^\s*\|.+\|\s*$/m.test(output)) problems.push(`${batch.id}: table syntax found`);
+    if (/^\s*\d+\.\s+/m.test(output)) problems.push(`${batch.id}: ordered list found`);
+    if (/^#\s+/m.test(output)) problems.push(`${batch.id}: first-level heading found`);
+    if (/^---\s*$/m.test(output)) problems.push(`${batch.id}: horizontal rule found`);
+    if (output.length < batch.source.length * 0.25) problems.push(`${batch.id}: suspiciously short output`);
+    const bodyLines = output.split(/\r?\n/).filter((line) => line.trim() && !line.startsWith("#"));
+    for (const [index, line] of bodyLines.entries()) {
+      if (/[。！？；：]$/.test(line)) continue;
+      problems.push(`${batch.id}:${index + 1}: line lacks Chinese terminal punctuation: ${line}`);
+      break;
+    }
+  }
+  return problems;
+}
+
+function assemble(batches) {
+  const parts = ["# 大事记续编白话本", ""];
+  batches.forEach((batch, index) => {
+    const output = normalizeBatchOutput(readBatch(batch));
+    if (!output) throw new Error(`Missing output for batch ${batch.id}`);
+    parts.push(output);
+    if (index + 1 < batches.length) parts.push("");
+  });
+  const content = parts.join("\n").replace(/\n{4,}/g, "\n\n\n") + "\n";
+  fs.writeFileSync(outputPath, content, "utf8");
+  return content;
+}
+
+async function main() {
+  fs.mkdirSync(stateDir, { recursive: true });
+  const source = fs.readFileSync(inputPath, "utf8");
+  const sourceHash = crypto.createHash("sha256").update(source, "utf8").digest("hex");
+  const manifestPath = path.join(stateDir, "manifest.json");
+  let manifest = { sourceHash, batches: [] };
+  if (fs.existsSync(manifestPath)) {
+    manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
+    if (manifest.sourceHash !== sourceHash) throw new Error("Source hash changed; clear the processing state and restart");
+  }
+  const batches = buildBatches(source);
+  manifest = {
+    sourceHash,
+    batches: batches.map((batch) => ({ id: batch.id, section: batch.section, part: batch.part, parts: batch.parts })),
+  };
+  fs.writeFileSync(manifestPath, JSON.stringify(manifest, null, 2), "utf8");
+
+  let selected = batches;
+  if (onlyBatch > 0) selected = batches.filter((batch) => batch.id === onlyBatch);
+  if (limit > 0) selected = selected.slice(0, limit);
+  console.log(`Batches total=${batches.length}, selected=${selected.length}, concurrency=${concurrency}, maxChars=${maxChars}`);
+  await runLimited(selected);
+
+  const allDone = batches.every((batch) => readBatch(batch));
+  if (allDone) {
+    const problems = validateOutputs(batches);
+    if (problems.length > 0) {
+      console.error(problems.join("\n"));
+      throw new Error(`Validation failed with ${problems.length} problem(s)`);
+    }
+    const content = assemble(batches);
+    console.log(`Assembled ${batches.length} batches into ${outputPath} (${content.length} chars)`);
+  } else {
+    const done = batches.filter((batch) => readBatch(batch)).length;
+    console.log(`Processed ${done}/${batches.length} batches. Rerun the script to continue.`);
+  }
+}
+
+main().catch((error) => {
+  console.error(error.stack || error.message);
+  process.exitCode = 1;
+});
