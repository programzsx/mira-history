+每个句子只表达一个意思。
+每个句子必须以中文句号结尾。
+每个句子内部不要换行。
+专业术语、生僻字、典故和古代制度要紧跟第一次出现处说明。
+生僻字要说明读音和意思。
+典故要说明出处和含义。
+不确定的内容不要编造，要写明含义不确定。
+人名、地名、书名、数字保持不变。
+不要改变事实。
+语言要符合zsx-lan风格。
+句子要短。
+主语要明确。
+只输出JSON数组。`;
+
+function sleep(ms) {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+function readSourceLines() {
+  const source = fs.readFileSync(sourcePath, "utf8").replace(/''^'"\\uFEFF/, \"\");
+  return source.split(/\\r?\\n/).map((line) => line.trim()).filter((line) => line.length > 0);
+}
+
+function buildBatches(lines) {
+  const batches = [];
+  let current = [];
+  let currentChars = 0;
+  for (const line of lines) {
+    if (current.length > 0 && (current.length >= maxLinesPerBatch || currentChars + line.length > maxCharsPerBatch)) {
+      batches.push(current);
+      current = [];
+      currentChars = 0;
+    }
+    current.push(line);
+    currentChars += line.length;
+  }
+  if (current.length > 0) batches.push(current);
+  return batches;
+}
+
+function makeUserPrompt(batch) {
+  return batch.map((line, index) => "'`L${index + 1}'"\\t"'${line}`).join("'"\\n\");
+}
+
+function extractText(response) {
+  if (response?.status "'!== "completed") {
+    throw new Error(`API状态不是completed：${response?.status || "unknown"} ${JSON.stringify(response?.incomplete_details || response?.error || null)}`);
+  }
+  const output = Array.isArray(response?.output) ? response.output : [];
+  const parts = [];
+  for (const item of output) {
+    if (item?.type !== "message" || !Array.isArray(item?.content)) continue;
+    for (const content of item.content) {
+      if (content?.type === "output_text" && typeof content?.text === "string") parts.push(content.text);
+    }
+  }
+  const text = parts.join("'"\\n\").trim();
+  if ("'!text) throw new Error("API没有返回正文");
+  return text;
+}
+
+function parseModelJson(text) {
+  let candidate = text.trim();
+  candidate = candidate.replace(/''^```(?:json)?'"\\s*/i, \"\").replace(/\\s*"'```$/i, "");
+  const start = candidate.indexOf("[");
+  const end = candidate.lastIndexOf("]");
+  if (start < 0 || end <= start) throw new Error("模型输出中没有JSON数组");
+  const parsed = JSON.parse(candidate.slice(start, end + 1));
+  if (!Array.isArray(parsed)) throw new Error("模型输出不是JSON数组");
+  return parsed;
+}
+
+function normalizeId(value) {
+  if (typeof value === "number") return `L${value}`;
+  const text = String(value).trim();
+  return /''^L?'"\\d+"'$/i.test(text) ? (text.toUpperCase().startsWith("L") ? text.toUpperCase() : `L${text}`) : text;
+}
+
+function splitSentences(value) {
+  if (Array.isArray(value)) return value.flatMap(splitSentences);
+  if (typeof value !== "string") throw new Error("s字段必须是字符串数组");
+  return value
+    .replace(/'"\\r/g, \"\")
+    .split(/\\n+/)
+    .flatMap((line) => line.split(/(?<=。)/))
+    .map((line) => line.trim())
+    .filter((line) => line.length > 0);
+}
+
+function validateBatch(batch, parsed) {
+  const expected = new Set(batch.map((_, index) => "'`L${index + 1}`));
+  const seen = new Set();
+  const sentences = [];
+  for (const item of parsed) {
+    if (!item || typeof item !== "object") throw new Error("数组元素不是对象");
+    const id = normalizeId(item.i);
+    if (!expected.has(id)) throw new Error(`出现意外编号：${id}`);
+    if (seen.has(id)) throw new Error(`编号重复：${id}`);
+    seen.add(id);
+    const items = splitSentences(item.s);
+    if (items.length === 0) throw new Error(`编号没有译文：${id}`);
+    for (const sentence of items) {
+      if (!sentence.endsWith("。")) throw new Error(`编号${id}有不以中文句号结尾的句子`);
+      if (/[|]/.test(sentence)) throw new Error(`编号${id}的句子包含表格符号`);
+      if (/''^'"\\s*\\d+\\s*[.)]/.test(sentence)) throw new Error("'`编号${id}的句子像有序列表`);
+      sentences.push(sentence);
+    }
+  }
+  const missing = [...expected].filter((id) => !seen.has(id));
+  if (missing.length > 0) throw new Error(`缺少编号：${missing.join(",")}`);
+  return sentences;
+}
+
+async function callModel(batch, attempt) {
+  const payload = {
+    model,
+    input: [
+      { role: "system", content: systemPrompt },
+      { role: "user", content: makeUserPrompt(batch) },
+    ],
+    max_output_tokens: maxOutputTokens,
+    reasoning: { effort: "low" },
+  };
+  const response = await fetch("https://zhenze-huhehaote.cmecloud.cn/v1/responses", {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${process.env.ZHENZE_API_KEY}`,
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify(payload),
+    signal: AbortSignal.timeout(15 * 60 * 1000),
+  });
+  if (!response.ok) {
+    const body = await response.text();
+    throw new Error(`HTTP ${response.status}：${body.slice(0, 1000)}`);
+  }
+  const data = await response.json();
+  const text = extractText(data);
+  const parsed = parseModelJson(text);
+  const sentences = validateBatch(batch, parsed);
+  console.log(`batch ok ${attempt.attempt}: ${sentences.length} sentences, ${data.usage?.output_tokens || 0} output tokens`);
+  return sentences;
+}
+
+async function callWithRetry(batch, attempt) {
+  const delays = [0, 5000, 15000, 30000, 60000, 120000];
+  let lastError;
+  for (let retry = 0; retry < delays.length; retry += 1) {
+    if (delays[retry] > 0) await sleep(delays[retry]);
+    try {
+      return await callModel(batch, { ...attempt, attempt: retry + 1 });
+    } catch (error) {
+      lastError = error;
+      console.error(`batch fail ${attempt.attempt} retry ${retry + 1}: ${error.message}`);
+    }
+  }
+  throw lastError;
+}
+
+function loadCheckpoint() {
+  try {
+    const parsed = JSON.parse(fs.readFileSync(checkpointPath, "utf8"));
+    if (parsed && typeof parsed === "object" && Array.isArray(parsed.results)) return parsed;
+  } catch (_) {}
+  return { results: [] };
+}
+
+function saveCheckpoint(checkpoint) {
+  fs.writeFileSync(checkpointPath, JSON.stringify(checkpoint), "utf8");
+}
+
+async function main() {
+  const lines = readSourceLines();
+  const batches = buildBatches(lines);
+  const checkpoint = loadCheckpoint();
+  checkpoint.results.length = batches.length;
+  console.log(`source lines: ${lines.length}, batches: ${batches.length}, completed: ${checkpoint.results.filter(Boolean).length}`);
+
+  let cursor = 0;
+  let active = 0;
+  let failures = 0;
+  await new Promise((resolve, reject) => {
+    const launch = () => {
+      while (active < concurrency && cursor < batches.length) {
+        const index = cursor;
+        cursor += 1;
+        if (checkpoint.results[index]) continue;
+        active += 1;
+        callWithRetry(batches[index], { attempt: index + 1 })
+          .then((sentences) => {
+            checkpoint.results[index] = sentences;
+            saveCheckpoint(checkpoint);
+          })
+          .catch((error) => {
+            failures += 1;
+            console.error(`batch ${index + 1} finally failed: ${error.message}`);
+          })
+          .finally(() => {
+            active -= 1;
+            if (failures > 0 || cursor >= batches.length) {
+              if (active === 0) failures > 0 ? reject(new Error("有批次失败")) : resolve();
+            } else {
+              launch();
+            }
+          });
+      }
+      if (active === 0) resolve();
+    };
+    launch();
+  });
+
+  if (checkpoint.results.some((result) => !result)) throw new Error("检查点存在缺口");
+  const allSentences = checkpoint.results.flat();
+  const output = ["# 大事记的白话形式", "", ...allSentences, ""].join("'"\\n\");
+  fs.writeFileSync(outputPath, output, \"utf8\");
+  console.log("'`output written: ${outputPath}`);
+  console.log(`output lines: ${allSentences.length}`);
+}
+
+main().catch((error) => {
+  console.error(error.stack || error.message);
+  process.exitCode = 1;
+});
