+const checkpointPath = path.join(process.env.TEMP || __dirname, \"mira-dashiji-checkpoint.json\");
+const model = \"glm-5.3\";
+const maxLinesPerBatch = 160;
+const maxCharsPerBatch = 16000;
+const concurrency = 4;
+const maxOutputTokens = 30000;
+
+const systemPrompt = "'`你是古籍白话化批处理引擎。
+输入中每一行都有L编号和制表符，编号后是待处理文本。
+你要处理每一个L编号。
+不要在输出中包含原文。
+输出必须是合法JSON数组。
+数组每个元素形如{"i":"L1","s":["现代中文句子。","另一个句子。"]}。
